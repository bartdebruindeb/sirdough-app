# Database — give each bakery its OWN database (even on the same Postgres server)
DATABASE_URL="postgresql://postgres:YOURPASSWORD@localhost:5432/digitalbakery"

# Auth
NEXTAUTH_SECRET="change-me-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000/digitalbakery"

# Tenant — must match the `slug` of the Tenant row created by your seed script.
# This is what makes a deployment resolve to exactly ONE bakery, always.
TENANT_SLUG="meneer-leffers"

# Port — give each bakery instance its own port if running on the same VPS
# (e.g. Leffers on 3000, second bakery on 3001). nginx routes by subdomain
# to the matching port. See DEPLOYMENT.md.
PORT=3000

NODE_ENV="production"
